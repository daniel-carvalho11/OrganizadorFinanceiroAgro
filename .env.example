# Copie este arquivo para ".env" e preencha com os seus valores.
# O ".env" está no .gitignore: ele nunca vai para o GitHub nem para o Render.

# Chave da API do Google Gemini (usada pelo Agent1 na extração da Nota Fiscal)
GEMINI_API_KEY=

# Banco de dados LOCAL de cada desenvolvedor (PostgreSQL rodando na sua máquina).
# Em produção (Render) esta variável é configurada no painel do serviço, não aqui.
# Sem esta linha, o app usa o SQLite "financeiro.db" na pasta do projeto.
DATABASE_URL=postgresql://agro:agro@localhost:5432/agro_financeiro
